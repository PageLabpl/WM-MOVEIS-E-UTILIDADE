# ================================================================
# COPIE ESTE ARQUIVO PARA ".env" E PREENCHA COM VALORES REAIS.
# NUNCA envie o arquivo ".env" para o GitHub. Ele já está no .gitignore.
# No Render, essas variáveis são configuradas em: Dashboard > seu serviço > Environment
# ================================================================

# Ambiente: "production" no Render, "development" localmente
NODE_ENV=development

# Porta (o Render define isso sozinho via process.env.PORT, deixe como está)
PORT=4000

# --- Banco de dados PostgreSQL ---
# Pode ser um Postgres do próprio Render (Render > New > PostgreSQL) ou do Supabase.
# Exemplo Render:  postgres://usuario:senha@host:5432/banco
# Exemplo Supabase: postgres://postgres:senha@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://usuario:senha@localhost:5432/wm_moveis
# Em produção no Render, normalmente é necessário SSL:
DATABASE_SSL=true

# --- Autenticação / JWT ---
# Gere um valor forte e aleatório, por exemplo rodando:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_isso_por_um_valor_aleatorio_de_128_caracteres
JWT_EXPIRES_IN=8h

# --- Conta do administrador inicial (usada apenas pelo script scripts/createAdmin.js) ---
ADMIN_EMAIL=admin@wmoveis.com.br
ADMIN_PASSWORD=DefinaUmaSenhaForteAqui123!

# --- Cloudinary (armazenamento de imagens dos produtos e banners) ---
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# --- CORS: domínio(s) autorizados a chamar a API (separados por vírgula) ---
# Ex: https://wmoveis.com.br,https://www.wmoveis.com.br
# Em desenvolvimento local, pode usar http://localhost:5500 ou o endereço do seu servidor local
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Cookies ---
# Em produção (HTTPS no Render) deixe true. Em localhost sem HTTPS, use false.
COOKIE_SECURE=false
